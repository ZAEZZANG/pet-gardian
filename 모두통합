"""
📌 FINAL INTEGRATED SYSTEM (RASPBERRY PI)

✔ 위성 PIR(ESP32-C3 MQTT) → 사람 입장/퇴장 감지 → Home/Away Mode 전환
✔ 일체형 PIR → 반려동물 감지 시 센서 전원 Wake-up
✔ Thermal(MLX90640) → 사람/동물 분류 + 체온 수집
✔ mmWave → 호흡수 FFT 기반 계산
✔ Mode-based alert system (Home / Relax / Away)
✔ Telegram + Console alert
"""

import time, signal
from datetime import datetime
import numpy as np
import paho.mqtt.client as mqtt

from gpiozero import MotionSensor, OutputDevice, Device
from gpiozero.pins.lgpio import LGPIOFactory
Device.pin_factory = LGPIOFactory()

import requests
import serial
from scipy.signal import detrend
from scipy.fft import rfft, rfftfreq
import board, busio, adafruit_mlx90640


# ====================== 사용자 설정 ======================

MQTT_SERVER = "localhost"   # 라즈베리파이 IP
MQTT_PORT = 1883   # 라즈베리파이 IP
MQTT_TOPIC_PERSON = "room1/person"

USE_TELEGRAM = True
BOT_TOKEN = "YOUR_TELEGRAM_TOKEN"
CHAT_ID = "YOUR_CHAT_ID"

PIR_MAIN_PIN = 17
MMW_PWR_PIN = 22
THERM_PWR_PIN = 27
ACTIVE_HIGH = True

AWAY_TIMEOUT_SEC = 300
RELAX_DURATION_SEC = 20 * 60
SAMPLING_WINDOW_SEC = 8

SPECIES = "dog"
BREATH_RANGE = (15, 30) if SPECIES == "dog" else (20, 40)

TEMP_WARNING = 39.0
TEMP_DANGER = 39.5


# ====================== Utility ======================

def send_alert(msg):
    print("\n🔔 ALERT:", msg, "\n")
    if not USE_TELEGRAM: 
        return
    try:
        requests.post(f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage",
            data={"chat_id": CHAT_ID, "text": msg}, timeout=3)
    except:
        print("⚠ Telegram send failed")


# ====================== 센서 클래스 ======================

class ThermalSensor:
    def __init__(self):
        self.i2c = busio.I2C(board.SCL, board.SDA, frequency=400000)
        self.sensor = adafruit_mlx90640.MLX90640(self.i2c)
        self.sensor.refresh_rate = adafruit_mlx90640.RefreshRate.REFRESH_4_HZ

    def read(self):
        frame = [0]*768
        self.sensor.getFrame(frame)
        return np.array(frame).reshape(24, 32)


class MmWaveSensor:
    def __init__(self, port="/dev/serial0", baud=115200):
        self.ser = serial.Serial(port, baud, timeout=0.25)
        self.buffer = []

    def get_bpm(self):
        raw = self.ser.read(100)
        if not raw:
            return None

        self.buffer.append(len(raw) % 50)

        if len(self.buffer) > SAMPLING_WINDOW_SEC * 4:
            self.buffer.pop(0)

        if len(self.buffer) < 15:
            return None

        cleaned = detrend(np.array(self.buffer))
        freqs = rfftfreq(len(cleaned), 0.25)
        spectrum = np.abs(rfft(cleaned))

        mask = (freqs >= 0.1) & (freqs <= 1.0)
        if not np.any(mask): return None

        return round(freqs[mask][np.argmax(spectrum[mask])] * 60, 1)


# ====================== 시스템 컨트롤 ======================

class PetMonitorSystem:
    def __init__(self):
        self.pir = MotionSensor(PIR_MAIN_PIN)

        self.mmw_power = OutputDevice(MMW_PWR_PIN, active_high=ACTIVE_HIGH, initial_value=False)
        self.therm_power = OutputDevice(THERM_PWR_PIN, active_high=ACTIVE_HIGH, initial_value=False)

        self.active_until = 0
        self.mode = "away"
        self.last_human_time = None

        self.mmwave = None
        self.thermal = None

    # ---------- MQTT(위성 PIR) 이벤트 처리 ----------
    def handle_satellite_event(self, payload):
        now = time.time()

        if payload == "door_cross":
            if self.mode == "away":
                self.mode = "home"
                self.last_human_time = now
                send_alert("🚪 사람이 집에 들어왔습니다. → HOME MODE")
            else:
                self.mode = "away"
                send_alert("🚶 사람이 외출했습니다. → AWAY MODE")

    # ---------- 시스템 전원 제어 ----------
    def wake_sensors(self):
        self.active_until = time.time() + 60

        if not self.mmwave:
            print("📡 mmWave ON")
            self.mmw_power.on()
            time.sleep(0.5)
            self.mmwave = MmWaveSensor()

        if not self.thermal:
            print("🔥 Thermal Camera ON")
            self.therm_power.on()
            time.sleep(1.2)
            self.thermal = ThermalSensor()

    def maybe_shutdown_sensors(self):
        if time.time() > self.active_until:
            if self.mmwave:
                print("📡 mmWave OFF")
                self.mmwave = None
                self.mmw_power.off()

            if self.thermal:
                print("🔥 Thermal OFF")
                self.thermal = None
                self.therm_power.off()

    # ---------- 상태 판정 ----------
    def classify_frame(self, frame):
        mask = frame >= 30
        if not np.any(mask): return "none", 0, None

        ys, xs = np.where(mask)
        area = len(xs)

        xmin, xmax = xs.min(), xs.max()
        ymin, ymax = ys.min(), ys.max()
        ratio = (ymax - ymin + 1) / (xmax - xmin + 1)
        hotspot = frame[mask].max()

        if area > 200 and ratio > 1.4: return "human", area, hotspot
        if 30 < area <= 200: return "pet", area, hotspot
        
        return "unknown", area, hotspot

    def evaluate(self, identity, bpm, temp):
        if identity == "human":
            return "👤 Human detected (ignored)"

        if bpm is None or temp is None:
            return "⏳ Collecting..."

        status = "🟢 정상"
        
        if temp >= TEMP_DANGER: status = "🚨 고열"
        elif temp >= TEMP_WARNING: status = "⚠ 발열"

        minB, maxB = BREATH_RANGE
        if bpm < minB or bpm > maxB:
            status += " + ⚠ 호흡 이상"

        msg = f"{identity.upper()} | BPM={bpm}, Temp={temp:.1f}°C → {status}"

        if "🚨" in status or ("⚠" in status and self.mode == "away"):
            send_alert("❗긴급 상태 감지\n" + msg)

        return msg

    # ---------- 메인 루프 ----------
    def run(self):
        print("\n=== 🐾 SMART PET HEALTH MONITOR START ===\n")

        while True:
            if self.pir.motion_detected:
                print("🐶 Movement detected → Sensors waking")
                self.wake_sensors()

            if self.mmwave and self.thermal:
                frame = self.thermal.read()
                identity, _, temp = self.classify_frame(frame)
                bpm = self.mmwave.get_bpm()
                print("[STATUS]", self.evaluate(identity, bpm, temp))

            self.maybe_shutdown_sensors()
            time.sleep(1)



# ====================== MQTT 연결 ======================

system = PetMonitorSystem()

def on_message(client, user, msg):
    system.handle_satellite_event(msg.payload.decode())

client = mqtt.Client()
client.on_message = on_message
client.connect(MQTT_SERVER, 1883, 60)
client.subscribe(MQTT_TOPIC_PERSON)
client.loop_start()


# ====================== RUN ======================

try:
    system.run()
except KeyboardInterrupt:
    print("\n🛑 SYSTEM STOPPED\n")

