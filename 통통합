# -*- coding: utf-8 -*-

"""
📌 Integrated Pet Monitoring System
- Always-on PIR (motion baseline detector)
- mmWave (breathing + micro-motion detection)
- Thermal camera (temperature + size detection)

Logic:
✔ PIR always listens
✔ Movement OR breathing detected → sensors stay ON
✔ If NO movement & NO breathing change for X sec → sensors OFF (sleep mode)

Goal:
- Detect sleep normally
- Avoid shutting down while pet is still present but sleeping
"""

import time
import threading
from datetime import datetime
from gpiozero import MotionSensor, OutputDevice


# ==========================
# USER CONFIG
# ==========================
PIR_PIN = 17
MMW_PWR_PIN = 22
THERM_PWR_PIN = 27
ACTIVE_HIGH = True

WARMUP_MMW = 0.5
WARMUP_THERM = 1.5

NO_ACTIVITY_TIMEOUT = 120       # 2분 동안 motion + breathing 둘 다 변화 없으면 OFF
BREATH_STILL_THRESHOLD = 5      # breathing 변화 없다고 판단 기준 (bpm 변화량)
MIN_SLEEP_TIME = 20             # mmWave가 breathing 안정 신호 잡아야 sleep으로 인정


# ==========================
# State Variables
# ==========================
last_activity_time = time.time()
system_awake = False

breathing_history = []
motion_level_history = []


# ==========================
# Hardware Power Control
# ==========================
class PowerControl:
    def __init__(self, pin):
        self.dev = OutputDevice(pin, active_high=ACTIVE_HIGH) if pin else None

    def on(self):
        if self.dev:
            self.dev.on()

    def off(self):
        if self.dev:
            self.dev.off()


mmw_power = PowerControl(MMW_PWR_PIN)
thermal_power = PowerControl(THERM_PWR_PIN)


# ==========================
# Dummy sensor readings (TEMP CODE)
# Replace later with mmWave + IR logic
# ==========================
def get_mmwave_readings():
    """Simulated mmWave output."""
    import random
    return {
        "bpm": random.choice([15, 20, 23, 0, 0, 18, 22, 24]),
        "motion": random.choice([0, 2, 1, 10, 0, 0, 1])
    }

def get_thermal_readings():
    """Simulated thermal output."""
    import random
    return random.uniform(30.0, 38.5), random.randint(5, 80)  # (Temp, hot pixel count)


# ==========================
# System Behavior Logic
# ==========================
def wake_system():
    global system_awake
    if not system_awake:
        print("🐶 Movement detected → Waking sensors...")
        mmw_power.on()
        thermal_power.on()
        time.sleep(WARMUP_MMW)
        time.sleep(WARMUP_THERM)
        system_awake = True


def sleep_system():
    global system_awake
    if system_awake:
        print("😴 No movement for a while → Sensors entering low power mode...")
        mmw_power.off()
        thermal_power.off()
        system_awake = False


# ==========================
# PIR Handler
# ==========================
pir = MotionSensor(PIR_PIN)

def pir_triggered():
    global last_activity_time
    last_activity_time = time.time()
    wake_system()

pir.when_motion = pir_triggered



# ==========================
# MAIN MONITOR LOOP
# ==========================
def main_loop():
    global last_activity_time

    print("\n=== PET HEALTH MONITOR ACTIVE ===")
    print("Waiting for motion...\n")

    while True:
        now = time.time()

        if system_awake:
            mm_data = get_mmwave_readings()
            temp, pixels = get_thermal_readings()

            breathing_history.append(mm_data["bpm"])
            motion_level_history.append(mm_data["motion"])

            if len(breathing_history) > 15:
                breathing_history.pop(0)
                motion_level_history.pop(0)

            stable_breathing = all(abs(breathing_history[-1] - x) < BREATH_STILL_THRESHOLD for x in breathing_history[-10:])
            low_motion = max(motion_level_history[-5:]) < 2

            if low_motion and stable_breathing:
                # Animal sleeping, update last activity to prevent shutdown too early
                last_activity_time = now  
                print("[STATUS] 💤 Stable breathing detected (sleep mode)")

            else:
                print(f"[STATUS] Active | BPM={mm_data['bpm']} Temp={temp:.1f}°C Pixels={pixels}")

            # Check inactivity timeout
            if now - last_activity_time > NO_ACTIVITY_TIMEOUT:
                sleep_system()

        else:
            print("[STATUS] 📴 Idle — waiting for movement...")
            time.sleep(1)

        time.sleep(1)


# ==========================
# Run
# ==========================
if __name__ == "__main__":
    try:
        main_loop()
    except KeyboardInterrupt:
        sleep_system()
        print("\nProgram terminated.")


